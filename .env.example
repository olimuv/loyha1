# OmniAI - Environment variables namunasi
# Bu faylni nusxalab .env nomli fayl yarating
# .env faylini hech qachon Git'ga qo'shmang!

# Flask sozlamalari
SECRET_KEY=your-very-secret-key-change-this-in-production-min-32-chars
FLASK_ENV=development
FLASK_DEBUG=True

# Ma'lumotlar bazasi
# Mahalliy ishlab chiqishda SQLite (avtomatik yaratiladi)
DATABASE_URL=sqlite:///omniAI.db
# Production uchun PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/omniAI

# AI Provider (ixtiyoriy - bo'lmasa fallback rejimi ishlaydi)
# OpenAI API kaliti: https://platform.openai.com/api-keys
# Narx: Taxminan $0.002 per 1K token (GPT-3.5-turbo uchun)
OPENAI_API_KEY=
# Yoki boshqa provider:
# ANTHROPIC_API_KEY=

# Rate Limiting
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=memory://

# Session sozlamalari
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Email (kelajakda parolni tiklash uchun - hozircha o'chiriq)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Ilovaning asosiy URL manzili
BASE_URL=http://localhost:5000
